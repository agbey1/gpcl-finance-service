# GPCL Finance Service configuration.
# Copy to .env (Docker / PM2) or .env.local (npm run dev) and fill in.
# Never commit the real file.

NODE_ENV=production
PORT=3006

# --- Authentication -------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Rotating it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-value
# Session lifetime in seconds (default 8 hours, max 7 days).
JWT_EXPIRES_IN_SECONDS=28800
# Keep true in production (HTTPS). Set false only for local http development.
COOKIE_SECURE=true

# --- SQL Server -----------------------------------------------------------
SQLSERVER_HOST=db.example.internal
SQLSERVER_PORT=1433
# SQLSERVER_INSTANCE=            # named instance instead of port, if used
SQLSERVER_DATABASE=GPCLFinanceResource
# Use a dedicated least-privilege login, not sa.
SQLSERVER_USER=gpcl_finance_app
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
# true only if the server uses a self-signed certificate
SQLSERVER_TRUST=false
DB_POOL_MAX=20

# --- Networking -----------------------------------------------------------
# true only when running behind a reverse proxy (IIS/nginx) that sets
# X-Forwarded-For; otherwise clients could spoof their IP for rate limiting.
TRUST_PROXY=false

# --- Logging --------------------------------------------------------------
# Logs always go to stdout/stderr. Also append to ./logs/*.log:
LOG_TO_FILE=false

# --- docker-compose development database only -----------------------------
MSSQL_SA_PASSWORD=
